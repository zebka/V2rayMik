#!/bin/sh
# Shared preamble for every CGI. Not executable on purpose.
# The panel has no password; it is served to the LAN only, through the
# router's dst-nat. Do not expose it beyond the LAN.
# APP_DIR exists so the test suite can run outside the image.
_APP=${APP_DIR:-/app}
. "$_APP/lib/admin.sh"
. "$_APP/lib/links.sh"
. "$_APP/lib/routes.sh"
. "$_APP/lib/subs.sh"
. "$_APP/lib/xray.sh"

DATA_DIR=${DATA_DIR:-/data}
SUB_FILE=${SUB_FILE:-$DATA_DIR/sub.txt}
STATE_FILE=${STATE_FILE:-$DATA_DIR/state.json}
STATUS_FILE=${STATUS_FILE:-$DATA_DIR/status.json}

json_header() {
  printf 'Content-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n'
}

ok_json() {
  json_header
  printf '%s' "$1"
  exit 0
}

fail_json() {
  printf 'Status: %s\r\n' "$1"
  json_header
  printf '{"ok":false,"error":"%s"}' "$(json_escape "$2")"
  exit 0
}
