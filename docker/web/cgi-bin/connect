#!/bin/sh
. /app/web/cgi-bin/_common
. /app/lib/xtest.sh

require_auth
[ "${REQUEST_METHOD:-GET}" = "POST" ] || fail_json "405 Method Not Allowed" "POST only"

body=$(read_body)
idx=$(form_get "$body" "i")
gen=$(form_get "$body" "gen")

case "$idx" in ''|*[!0-9]*) fail_json "400 Bad Request" "bad index" ;; esac
[ "$gen" = "$(gen_of "$SUB_FILE")" ] || fail_json "409 Conflict" "the list changed, reload"

link=$(subs_decode "$SUB_FILE" | sed -n "$((idx + 1))p")
[ -n "$link" ] || fail_json "400 Bad Request" "no such entry"

ob=$(link_to_outbound "$link" 2>/dev/null) || fail_json "400 Bad Request" "unsupported link"
ep=$(endpoint_of "$ob" 2>/dev/null) || fail_json "400 Bad Request" "no endpoint"
host=${ep%:*}

row=$(subs_entry "$link") || fail_json "400 Bad Request" "unparseable link"
label=${row%%|*}
port=${row##*|}
port_allowed "$port" "$ALLOWED_PORTS" || fail_json "409 Conflict" "port $port is blocked by the egress allowlist"

# Pin the endpoint address now: after this the supervisor never needs DNS.
ipv4=$(resolve_endpoint "$host") || fail_json "502 Bad Gateway" "cannot resolve $host"
if ! is_ipv4 "$host"; then
  ob=$(printf '%s' "$ob" | jq --arg ip "$ipv4" '.server = $ip')
fi

# Keep the previous config for rollback.
last_good="null"
if [ -f "$STATE_FILE" ]; then
  last_good=$(jq -c '{outbound:.outbound,label:.label,index:.index}' "$STATE_FILE" 2>/dev/null || echo null)
fi

mkdir -p "$DATA_DIR"
tmp="$STATE_FILE.tmp"
jq -n --argjson ob "$ob" --arg label "$label" --argjson idx "$idx" \
      --argjson lg "$last_good" --arg ip "$ipv4" \
  '{outbound:$ob,label:$label,index:$idx,endpoint_ip:$ip,updated:(now|todate),last_good:$lg}' \
  > "$tmp" || fail_json "500 Internal Server Error" "cannot write state"
chmod 600 "$tmp"
mv -f "$tmp" "$STATE_FILE"

kill -HUP 1 2>/dev/null || true

i=0
up=false
while [ "$i" -lt 20 ]; do
  sleep 1
  if [ -f "$STATUS_FILE" ] && jq -e '.up == true' "$STATUS_FILE" >/dev/null 2>&1; then
    up=true
    break
  fi
  i=$((i + 1))
done

# End-to-end: the router's next world request must actually reach the check URL.
# A fresh node can take an extra second or two, so give the probe two tries.
if [ "$up" = true ]; then
  up=false
  n=0
  while [ "$n" -lt 2 ]; do
    code=$(curl -s -o /dev/null --interface "${TUN_ADDR:-198.18.0.1}" --max-time 8 -w '%{http_code}' "$CHECK_URL" 2>/dev/null || echo 0)
    if [ "$code" = "204" ]; then up=true; break; fi
    n=$((n + 1))
    sleep 1
  done
fi

if [ "$up" = true ]; then
  ok_json "{\"ok\":true,\"label\":\"$(json_escape "$label")\",\"endpoint\":\"$(json_escape "$ipv4")\"}"
fi

# Roll back to the last known-good config.
if [ "$last_good" != "null" ] && [ -n "$last_good" ]; then
  jq -n --argjson lg "$last_good" \
    '{outbound:$lg.outbound,label:($lg.label // "previous"),index:($lg.index // -1),
      endpoint_ip:"",updated:(now|todate),last_good:null}' \
    > "$STATE_FILE.tmp" 2>/dev/null && chmod 600 "$STATE_FILE.tmp" && mv -f "$STATE_FILE.tmp" "$STATE_FILE"
  kill -HUP 1 2>/dev/null || true
  sleep 4
  fail_json "502 Bad Gateway" "the new config did not come up; restored the previous one"
fi

# Nothing to roll back to: drop the state so the supervisor falls back to the
# environment config instead of staying on a dead node.
rm -f "$STATE_FILE"
kill -HUP 1 2>/dev/null || true
sleep 4
fail_json "502 Bad Gateway" "the new config did not come up; reverted to the environment config"
