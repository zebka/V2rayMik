#!/bin/sh
# Public (unauthenticated) health endpoint, for the router's auto-route
# scheduler. It answers four booleans as plain text so RouterOS does not have to
# parse JSON:
#
#   selected=1   a node was chosen in the panel and its Stop button is not pressed
#   up=1         the supervisor says the tunnel started and tun0 is present
#   live=1       a 204 really came back through the tunnel (cached 5 s)
#   bypass=1     the panel was told to stop: world traffic should leave through
#                the ISP on purpose, not because the node died
#
# `bypass=1` forces `selected=0`. That is the whole Stop feature: the router's
# scheduler treats a stopped tunnel like a dead one, falls back to the ISP, and
# keeps sing-box and tun0 alive, so nothing restarts and Start costs one tick.
#
# No secrets, no labels: only what the router needs to move a route.
DATA_DIR=${DATA_DIR:-/data}
STATE_FILE=${STATE_FILE:-$DATA_DIR/state.json}
STATUS_FILE=${STATUS_FILE:-$DATA_DIR/status.json}
CACHE_FILE=${CACHE_FILE:-$DATA_DIR/live.cache}
BYPASS_FILE=${BYPASS_FILE:-$DATA_DIR/bypass.flag}
CHECK_URL=${CHECK_URL:-http://connectivitycheck.gstatic.com/generate_204}

# The probe must travel through the tunnel. Container-originated traffic is
# routed directly (see install_routes), so binding the source to the TUN address
# is what puts this request back on the tunnel path.
TUN_ADDR=${TUN_ADDR:-198.18.0.1}

# Below the scheduler's 10 s interval, so every run of the scheduler gets a fresh
# answer: a node that died is noticed on the next tick, and one that came back is
# used again on the next tick, instead of up to 20 s later.
LIVE_TTL=${LIVE_TTL:-5}

# A dead node costs the full timeout, and the router's fetch waits 4 s. Stay
# inside that: 3 s of probe plus a few shells of overhead still answers in time,
# and an answer that is cut off would be read as "not live" anyway.
PROBE_MAX_TIME=${PROBE_MAX_TIME:-3}

printf 'Content-Type: text/plain\r\nCache-Control: no-store\r\n\r\n'

bypass=0
[ -f "$BYPASS_FILE" ] && bypass=1

selected=0
if [ "$bypass" = 0 ] && [ -f "$STATE_FILE" ] \
   && jq -e '.outbound != null' "$STATE_FILE" >/dev/null 2>&1; then
  selected=1
fi

up=0
if [ -d /sys/class/net/tun0 ] && jq -e '.up == true' "$STATUS_FILE" >/dev/null 2>&1; then
  up=1
fi

# probe_live - prints 1 when a 204 comes back through the tunnel, else 0.
probe_live() {
  code=$(curl -s -o /dev/null --interface "$TUN_ADDR" -w '%{http_code}' \
           --max-time "$PROBE_MAX_TIME" "$CHECK_URL" 2>/dev/null || echo 0)
  [ "$code" = "204" ] && printf '1' || printf '0'
}

live=0
if [ "$up" = "1" ]; then
  now=$(date +%s)
  fresh=0
  if [ -f "$CACHE_FILE" ]; then
    ts=$(cut -d' ' -f1 "$CACHE_FILE" 2>/dev/null)
    val=$(cut -d' ' -f2 "$CACHE_FILE" 2>/dev/null)
    case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
    case "$val" in
      0|1) if [ $((now - ts)) -lt "$LIVE_TTL" ]; then live=$val; fresh=1; fi ;;
    esac
  fi
  if [ "$fresh" = 0 ]; then
    live=$(probe_live)
    printf '%s %s\n' "$now" "$live" > "$CACHE_FILE" 2>/dev/null || true
  fi
fi

printf 'selected=%s up=%s live=%s bypass=%s\n' "$selected" "$up" "$live" "$bypass"
