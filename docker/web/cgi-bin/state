#!/bin/sh
. /app/web/cgi-bin/_common

gen=$(gen_of "$SUB_FILE")
count=$(subs_count "$SUB_FILE")
testing=false
lock_held && testing=true

label=""
index=-1
engine=""
if [ -f "$STATE_FILE" ]; then
  label=$(jq -r '.label // ""' "$STATE_FILE" 2>/dev/null)
  index=$(jq -r '.index // -1' "$STATE_FILE" 2>/dev/null)
  engine=$(jq -r '.engine // "sing-box"' "$STATE_FILE" 2>/dev/null)
fi

tun=false
[ -d /sys/class/net/tun0 ] && tun=true

# The engine that is actually running, when the supervisor said something.
run_engine=""
problem=""
if [ -f "$STATUS_FILE" ]; then
  run_engine=$(jq -r '.engine // ""' "$STATUS_FILE" 2>/dev/null)
  problem=$(jq -r '.problem // ""' "$STATUS_FILE" 2>/dev/null)
fi
# DNS is hijacked into the proxy when the rendered sing-box config says so.
# This is what the config asks for, not a live probe.
dns_via_tunnel=false
if [ -f "${SINGBOX_CONFIG:-/etc/sing-box/config.json}" ] \
   && jq -e '.route.rules[]? | select(.action=="hijack-dns")' "${SINGBOX_CONFIG:-/etc/sing-box/config.json}" >/dev/null 2>&1; then
  dns_via_tunnel=true
fi

# The versions are written at build time: the repository's VERSION file (also
# the release tag) and the sing-box and Xray releases baked into the image.
version=$(cat /app/VERSION 2>/dev/null || echo "dev")
singbox=$(cat /app/SINGBOX_VERSION 2>/dev/null || echo "unknown")
xray=$(cat /app/XRAY_VERSION 2>/dev/null || echo "unknown")

list=$(subs_list "$SUB_FILE")

ok_json "{\"ok\":true,\"gen\":\"$(json_escape "$gen")\",\"count\":$count,\"label\":\"$(json_escape "$label")\",\"index\":$index,\"engine\":\"$(json_escape "$engine")\",\"run_engine\":\"$(json_escape "$run_engine")\",\"testing\":$testing,\"tun\":$tun,\"problem\":\"$(json_escape "$problem")\",\"container\":\"$(json_escape "${CONTAINER_NAME:-v2raymik}")\",\"dns_via_tunnel\":$dns_via_tunnel,\"version\":\"$(json_escape "$version")\",\"singbox\":\"$(json_escape "$singbox")\",\"xray\":\"$(json_escape "$xray")\",\"list\":$list}"
