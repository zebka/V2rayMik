#!/bin/sh
. /app/web/cgi-bin/_common

[ "${REQUEST_METHOD:-GET}" = "POST" ] || fail_json "405 Method Not Allowed" "POST only"

if lock_held; then
  fail_json "409 Conflict" "a test is running"
fi

body=$(read_body)
url=$(form_get "$body" "url")
links=$(form_get "$body" "links")

mkdir -p "$DATA_DIR"
tmp="$DATA_DIR/sub.tmp"

# The one free-form string in the panel. Two hard-won lessons applied:
#   - The User-Agent must not smell like a proxy client. A provider's edge or
#     DPI drops a request whose User-Agent contains "v2ray" without an answer —
#     curl sat until the timeout with zero bytes against a provider in Iran.
#     A plain browser string is the one thing safe everywhere tested.
#   - redirects are followed, but only to https and at most three of them
#     (providers' links 301 to the canonical URL often enough that refusing
#     them breaks real subscriptions); a downgrade to http is refused.
# The private-host block on the entry URL stops an open redirect to internal
# space from using this panel as an SSRF oracle; a redirect target itself is
# trusted, because otherwise every shortened provider link dies.
if [ -n "$url" ]; then
  case "$url" in
    http://*|https://*) ;;
    *) fail_json "400 Bad Request" "url must be http or https" ;;
  esac
  host=${url#*://}
  host=${host%%/*}
  host=${host%%:*}
  case "$host" in
    ''|localhost|127.*|0.0.0.0|10.*|192.168.*|169.254.*|172.16.*|172.17.*|172.18.*|172.19.*|172.2[0-9].*|172.3[01].*|\[::1\])
      fail_json "400 Bad Request" "url host looks private" ;;
  esac
  errf="$DATA_DIR/.fetch.err"
  code=$(curl -sS -L --max-redirs 3 --proto '=http,https' --proto-redir '=https' --max-time 25 \
           --max-filesize 2000000 \
           -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36" \
           -o "$tmp" -w '%{http_code}' "$url" 2>"$errf")
  rc=$?
  if [ "$rc" -ne 0 ]; then
    why=$(head -n 1 "$errf" 2>/dev/null | tr -d '\r' \
          | sed -e 's/^curl: ([0-9]*) //' | cut -c1-150)
    rm -f "$tmp" "$errf"
    fail_json "502 Bad Gateway" "could not fetch: curl $rc ${why}"
  fi
  rm -f "$errf"
  case "$code" in
    2*) ;;
    *)
      rm -f "$tmp"
      fail_json "502 Bad Gateway" "the subscription answered HTTP $code"
      ;;
  esac
elif [ -n "$links" ]; then
  printf '%s\n' "$links" > "$tmp"
else
  fail_json "400 Bad Request" "url or links required"
fi

if [ ! -s "$tmp" ]; then
  rm -f "$tmp"
  fail_json "400 Bad Request" "empty subscription"
fi

# Parse the payload before replacing the cached one: a login page or an
# unreadable payload must not throw away a list that still works.
count=$(subs_count "$tmp")
if [ "$count" -eq 0 ]; then
  why=$(subs_reject_reason "$tmp")
  rm -f "$tmp"
  fail_json "400 Bad Request" "$why"
fi

chmod 600 "$tmp"
mv -f "$tmp" "$SUB_FILE"

gen=$(gen_of "$SUB_FILE")
list=$(subs_list "$SUB_FILE")
ok_json "{\"ok\":true,\"gen\":\"$(json_escape "$gen")\",\"count\":$count,\"list\":$list}"
