#!/bin/sh
. /app/web/cgi-bin/_common
. /app/lib/xtest.sh

[ "${REQUEST_METHOD:-GET}" = "POST" ] || fail_json "405 Method Not Allowed" "POST only"

body=$(read_body)
idx=$(form_get "$body" "i")
gen=$(form_get "$body" "gen")
bytes=$(form_get "$body" "mb")

case "$idx" in ''|*[!0-9]*) fail_json "400 Bad Request" "bad index" ;; esac
# The panel asks for 10, 50, 100 or 200 MB. Anything else falls back to the
# default; a caller cannot make the container pull an arbitrary amount.
case "$bytes" in 10|50|99|100|200) bytes=$((bytes * 1000000)) ;; *) bytes=$SPEED_BYTES ;; esac
[ "$gen" = "$(gen_of "$SUB_FILE")" ] || fail_json "409 Conflict" "the list changed, reload"

lock_try || fail_json "409 Conflict" "a test is already running"
trap 'lock_release' EXIT

result=$(xtest_run "$idx" "$bytes")

lock_release
ok_json "$result"
